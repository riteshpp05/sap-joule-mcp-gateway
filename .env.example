# ===========================================================================
# SAP Joule AI Agent - Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure for your SAP landscape.

# --- SAP ADT Connection Settings ---
SAP_BASE_URL=https://s4hana-host.internal:44300
SAP_CLIENT=100
SAP_USERNAME=DEVELOPER
SAP_PASSWORD=your_sap_password_here
SAP_VERIFY_SSL=false

# --- Execution Mode ---
# Set to 'true' to run fully offline with simulated SAP ADT responses.
# Set to 'false' to connect to live SAP S/4HANA / NetWeaver systems.
SAP_MOCK_MODE=true

# --- AI Intelligence Settings ---
# Local Ollama model name (default: qwen2.5:3b)
OLLAMA_MODEL=qwen2.5:3b

# Google Gemini API Key (optional cloud fallback if Ollama is unavailable)
# GEMINI_API_KEY=your_gemini_api_key_here